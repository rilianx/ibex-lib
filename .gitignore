
# ... because it depends on the branch:
.travis.yml

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# eclipse settings
.cproject
.settings
.project

# python generated files
*.pyc

# waf generated stuff
.waf*
.lock-waf*
__build__

# ibex generated obj -- anchored to the repository root, otherwise "bin" also
# matches src/bin/ and silently hides sources placed there
/build
/lib
/include
/share
/bin
doc/images/*.png
doc/_build

# local artifacts, not part of the source
__pycache__/
*.zip
*.pdf
benchs/optim/*.tar.gz

*~


# files in examples
**/examples/*
!**/examples/*cpp
!**/examples/makefile

# results ibex files
*.cov
